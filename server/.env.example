# Copier en server/.env (jamais commité) et remplir. En production, tous les secrets
# sont OBLIGATOIRES (32 caractères minimum) : le serveur refuse de démarrer sinon.
# Générer une valeur : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# Signature des sessions (cookie HttpOnly)
JWT_SECRET=
# Signature des QR codes des billets (changer cette valeur invalide tous les billets émis)
TICKET_SECRET=
# Signature des notifications du prestataire de paiement
WEBHOOK_SECRET=

# URL publique du site (HTTPS obligatoire en production), utilisée dans les mails
PUBLIC_URL=https://billetterie.exemple.fr

# Port de l'API en développement (le front Vite est sur 5173)
API_PORT=3001
# Port en production (npm start)
PORT=3001
# Nombre de proxys devant l'application (ex. 1 derrière Nginx / un hébergeur)
TRUST_PROXY=0
# Emplacement de la base SQLite
# DB_FILE=/var/lib/tickekette/tickekette.db

# Prestataire de paiement : "mock" (démo, interdit en production) ou "none"
# PAYMENT_PROVIDER=none
# Outils de démo (boîte mail, horloge) : toujours désactivés en production
# ENABLE_DEV_TOOLS=true
