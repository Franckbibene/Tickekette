# `npm run dev` crée automatiquement server/.env s'il est absent. Pour le mode
# local durci, copier ce modèle en server/.env (jamais commité) puis le remplir.
# En démo comme en production, tous les secrets sont OBLIGATOIRES (32 caractères minimum).
# APP_MODE est fixé explicitement par les scripts npm (demo/test/production).
# Générer une valeur : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Protéger ensuite le fichier : chmod 600 server/.env. Sur la machine locale,
# conserver une copie de récupération dans un gestionnaire de mots de passe.

# Signature des sessions (cookie HttpOnly)
JWT_SECRET=
# Signature des QR codes des billets (changer cette valeur invalide tous les billets émis)
TICKET_SECRET=
# Signature des notifications du prestataire de paiement
WEBHOOK_SECRET=
# Chiffrement applicatif des données sensibles (corps des e-mails)
DATA_ENCRYPTION_KEY=

# URL locale utilisée dans les mails. En démo Vite : 5173. Avec npm start : 3001.
PUBLIC_URL=http://localhost:5173

# Port de l'API en développement (le front Vite est sur 5173)
API_PORT=3001
# Port du mode local durci (npm start)
PORT=3001
# Application locale : aucune adresse réseau externe et aucun proxy ne sont autorisés.
# HOST=127.0.0.1
TRUST_PROXY=0
# Emplacement de la base SQLite
# DB_FILE=/chemin/local/prive/tickekette.db

# Prestataire de paiement : "mock" (mode demo uniquement) ou "none"
# PAYMENT_PROVIDER=none
# Les commandes npm run dev/seed positionnent explicitement ces valeurs.
# Ne jamais les définir dans le mode local durci.
# ENABLE_DEV_TOOLS=false
# ALLOW_DEMO_DATA=false
