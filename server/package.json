{
  "name": "tickekette-server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "ENABLE_DEV_TOOLS=true node --env-file-if-exists=.env --disable-warning=ExperimentalWarning --watch src/index.js",
    "start": "NODE_ENV=production node --env-file-if-exists=.env --disable-warning=ExperimentalWarning src/index.js",
    "seed": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning src/seed.js",
    "test": "NODE_ENV=test node --disable-warning=ExperimentalWarning --test \"test/**/*.test.js\"",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "cookie-parser": "^1.4.7",
    "express": "^5.1.0",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.1",
    "typescript": "~5.9.3"
  },
  "engines": {
    "node": ">=22.9"
  }
}
