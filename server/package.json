{
  "name": "tickekette-server",
  "private": true,
  "type": "module",
  "scripts": {
    "setup:local": "node scripts/ensure-local-env.js",
    "predev": "npm run setup:local",
    "dev": "APP_MODE=demo ENABLE_DEV_TOOLS=true ALLOW_DEMO_DATA=true PAYMENT_PROVIDER=mock node --env-file-if-exists=.env --disable-warning=ExperimentalWarning --watch src/index.js",
    "start": "APP_MODE=production node --env-file-if-exists=.env --disable-warning=ExperimentalWarning src/index.js",
    "preseed": "npm run setup:local",
    "seed": "APP_MODE=demo ALLOW_DEMO_DATA=true node --env-file-if-exists=.env --disable-warning=ExperimentalWarning src/seed.js",
    "test": "APP_MODE=test node --disable-warning=ExperimentalWarning --test \"test/**/*.test.js\"",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "cookie-parser": "^1.4.7",
    "express": "^5.1.0",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "otplib": "^13.5.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.1",
    "typescript": "~5.9.3"
  },
  "engines": {
    "node": ">=22.9"
  }
}
